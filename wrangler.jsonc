{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chorescores",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chorescores",
      "database_id": "2a0f267a-dcde-47d1-a13e-4a31edef256d",
      "migrations_dir": "migrations"
    }
  ]
}
